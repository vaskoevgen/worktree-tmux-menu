# Generated by worktree-tmux-menu/install.sh.
# Re-run install.sh after editing the source template.

bind-key m display-menu -T "tmux: windows, panes, worktrees" \
  "New window"        c "new-window -c \"#{pane_current_path}\"" \
  "Next window"       n "next-window" \
  "Prev window"       p "previous-window" \
  "Rename window"     , "command-prompt -I '#W' 'rename-window %%'" \
  "" \
  "Split left/right"  h "split-window -h -c \"#{pane_current_path}\"" \
  "Split top/bottom"  v "split-window -v -c \"#{pane_current_path}\"" \
  "Zoom pane"         z "resize-pane -Z" \
  "Close pane"        x "confirm-before kill-pane" \
  "" \
  "New session"       S "command-prompt -p 'New session name:' 'new-session -s \"%%\" -c \"#{pane_current_path}\"'" \
  "List sessions"     s "choose-session" \
  "Delete session"    K "confirm-before -p 'Delete session #S? (y/n)' kill-session" \
  "Detach"            d "detach-client" \
  "" \
  "wt: open/switch worktree"       w "display-popup -E -w 95% -h 90% -d \"#{pane_current_path}\" -T \"wt: switch worktree\" \"@WT_TMUX_BIN@ open-ui\"" \
  "wt: new feature branch"         N "display-popup -E -w 80% -h 60% -d \"#{pane_current_path}\" -T \"wt: new feature\" \"@WT_TMUX_BIN@ feature-ui\"" \
  "wt: review GitHub PR"           R "display-popup -E -w 80% -h 60% -d \"#{pane_current_path}\" -T \"wt: review PR\" \"@WT_TMUX_BIN@ pr-ui\"" \
  "wt: new branch from GitHub PR"  B "display-popup -E -w 80% -h 60% -d \"#{pane_current_path}\" -T \"wt: branch from PR\" \"@WT_TMUX_BIN@ branch-from-pr-ui\"" \
  "wt: worktree status"            W "display-popup -E -w 95% -h 85% -d \"#{pane_current_path}\" -T \"wt: status\" \"@WT_TMUX_BIN@ list-ui\"" \
  "wt: commit changes"             C "display-popup -E -w 90% -h 80% -d \"#{pane_current_path}\" -T \"wt: commit\" \"@WT_TMUX_BIN@ commit-ui\"" \
  "wt: publish GitHub PR"          G "display-popup -E -w 90% -h 80% -d \"#{pane_current_path}\" -T \"wt: publish PR\" \"@WT_TMUX_BIN@ publish-ui\"" \
  "wt: merge into default branch"  M "display-popup -E -w 90% -h 80% -d \"#{pane_current_path}\" -T \"wt: merge\" \"@WT_TMUX_BIN@ merge-ui\"" \
  "wt: remove current worktree"    X "display-popup -E -w 90% -h 75% -d \"#{pane_current_path}\" -T \"wt: remove\" \"@WT_TMUX_BIN@ remove-ui\"" \
  "wt: command guide"              H "display-popup -E -w 90% -h 85% -d \"#{pane_current_path}\" -T \"wt: guide\" \"@WT_TMUX_BIN@ help-ui\""
